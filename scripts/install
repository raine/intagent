#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install [--prefix PATH]

Build and install intake executables and application skills.
The default prefix is ~/.local. INTAKE_INSTALL_PREFIX provides another default.
EOF
}

prefix="${INTAKE_INSTALL_PREFIX:-$HOME/.local}"
while (($# > 0)); do
  case "$1" in
    --prefix)
      if (($# < 2)); then
        printf '%s\n' 'scripts/install: --prefix requires a path' >&2
        exit 2
      fi
      prefix="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'scripts/install: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$prefix" in
  \~) prefix="$HOME" ;;
  \~/*) prefix="$HOME/${prefix#\~/}" ;;
esac
if [[ "$prefix" != /* ]]; then
  prefix="$PWD/$prefix"
fi

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
web_directory="${INTAKE_WEB_DIR:-$repository_root/web}"
if [[ "$web_directory" != /* ]]; then
  web_directory="$repository_root/$web_directory"
fi
bin_directory="$prefix/bin"
skills_directory="$prefix/share/intake/skills"
temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/intake-install.XXXXXX")"
cleanup() {
  rm -rf "$temporary_directory"
}
trap cleanup EXIT

cd "$repository_root"
printf 'Installing browser dependencies with npm %s...\n' "$(npm --version)"
npm ci --prefix "$web_directory"
npm run build --prefix "$web_directory"

printf 'Compiling release executables with %s...\n' "$(rustc --version)"
CARGO_TARGET_DIR="$temporary_directory/target" \
  INTAKE_DASHBOARD_DIR="$web_directory/generated" \
  cargo build --release --locked --bins

install -d -m 755 "$bin_directory" "$(dirname "$skills_directory")"
for executable in intake intake-fastmail-source intake-github-source; do
  install -m 755 "$temporary_directory/target/release/$executable" \
    "$bin_directory/$executable"
done

rm -rf "$skills_directory"
install -d -m 755 "$skills_directory"
cp -R skills/. "$skills_directory/"
find "$skills_directory" -type d -exec chmod 755 {} +
find "$skills_directory" -type f -exec chmod 644 {} +

XDG_STATE_HOME="$temporary_directory/state" "$bin_directory/intake" --help >/dev/null
printf 'Installed intake to %s\n' "$bin_directory"
printf 'Installed application skills to %s\n' "$skills_directory"
if [[ ":$PATH:" != *":$bin_directory:"* ]]; then
  printf 'Add %s to PATH to run intake by name.\n' "$bin_directory"
fi
printf 'Configure sources with:\n'
printf '  command: %s\n' "$bin_directory/intake-fastmail-source"
