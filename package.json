{
  "name": "personal-intake",
  "version": "0.1.0",
  "description": "Local intake monitor with restricted agent triage",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "skills",
    "examples",
    "LICENSE"
  ],
  "bin": {
    "intake": "src/cli.ts",
    "intake-fastmail-source": "src/sources/fastmail.ts",
    "intake-github-source": "src/sources/github.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/sources/fastmail.ts src/sources/github.ts --outdir dist --target bun",
    "install:local": "scripts/install",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build && bun run package:check && bun run validate:scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "bun run scripts/live-eval.ts",
    "package:check": "scripts/package-check",
    "validate:scripts": "bash -n hooks/pre-commit scripts/install scripts/install-git-hook-shims scripts/package-check"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "bash-parser": "0.5.0",
    "typebox": "1.3.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
